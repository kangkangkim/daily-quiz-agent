# ===== 每日一题 · 小老师 —— 环境变量示例 =====
# 用法：cp .env.example .env 修改后，启动时加载：
#   node --env-file=.env server.js        （Node 20.6+ 支持 --env-file）
# 或直接在命令前设置：PORT=8080 node server.js

# 服务端口（默认 3456）
PORT=3456

# "今天"的时区（默认 Asia/Shanghai）
QUIZ_TZ=Asia/Shanghai

# 小老师使用的模型（默认 haiku=快速档；留空则用运行时默认模型）
# 经 Anthropic 兼容网关时按网关映射取快速模型；也可填具体模型名
QUIZ_MODEL=haiku

# ---- 模型鉴权（二选一，不填则用本机 claude 登录态）----
# 方式 A：官方 Anthropic API
# ANTHROPIC_API_KEY=sk-ant-xxxx
# 方式 B：Anthropic 兼容网关（如 BigModel 等）
# ANTHROPIC_BASE_URL=https://xxx/api/anthropic
# ANTHROPIC_AUTH_TOKEN=xxxx
